  "authors": ["dalpner"],
  "contact": {
    "sources": "https://github.com/dalpner/MC_TowerDefense"
  },
  "icon": "assets/mctd/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["io.github.dalpner.mctd.MctdMod"],
    "client": ["io.github.dalpner.mctd.client.MctdClient"]
  },
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "1.21.1",
    "java": ">=21",
    "fabric-api": "*"
  }
}
